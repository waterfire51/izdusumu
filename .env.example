# Prisma Postgres (Prisma Data Platform veya kendi sunucunuz)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Admin oturumu — üretimde güçlü bir değer kullanın
AUTH_SECRET="uzun-rastgele-bir-secret-en-az-32-karakter"

# İlk admin kullanıcı (seed sırasında oluşturulur)
ADMIN_EMAIL="admin@izdusumuanaokulu.com"
ADMIN_PASSWORD="güçlü-bir-şifre"

# GitHub medya deposu — waterfire51/izdusumu_assets
GITHUB_TOKEN=""
GITHUB_REPO_OWNER="waterfire51"
GITHUB_REPO_NAME="izdusumu_assets"
